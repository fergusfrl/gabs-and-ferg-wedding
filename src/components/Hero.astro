---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
---

<section class="hero">
	<Image
		class="hero-image"
		src={heroImage}
		widths={[400, 800, 1600, 2400]}
		sizes="100vw"
		format="webp"
		quality={82}
		alt=""
		fetchpriority="high"
	/>
	<div class="hero-overlay"></div>
	<div class="hero-content">
		<h1>Gabrielle &amp; Fergus</h1>
		<p class="hero-subheading">6th May, 2023</p>
		<p class="hero-subheading">Ōhau Lodge, Lake Ōhau</p>
	</div>
</section>

<style>
	.hero {
		position: relative;
		width: 100%;
		height: 100vh;
		min-height: 480px;
		overflow: hidden;
	}

	.hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.4));
	}

	.hero-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		text-align: center;
		color: #fff;
		padding: 0 24px;
	}

	.hero-content h1 {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-weight: 400;
		font-size: clamp(2.5rem, 8vw, 5rem);
		letter-spacing: 0.02em;
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
	}

	.hero-subheading {
		margin: 12px 0 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1rem, 2.5vw, 1.25rem);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		opacity: 0.9;
		text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
	}
</style>
